<odoo>
    <record id="view_move_form_with_channel" model="ir.ui.view">
        <field name="name">account.move.form.channel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//sheet//group[1]" position="inside">
                <field name="sale_channel_id" readonly="1"/>
            </xpath>
            
            </field>
    </record>

    <record id="view_move_search_with_channel" model="ir.ui.view">
        <field name="name">account.move.search.channel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sale_channel_id"/>
            </xpath>
            
            <xpath expr="//filter[@name='group_by']" position="inside">
                <filter string="Canal de venta" name="group_by_sale_channel"
                        context="{'group_by': 'sale_channel_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>